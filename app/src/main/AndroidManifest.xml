<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<application
		android:allowBackup="true"
		android:enableOnBackInvokedCallback="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:localeConfig="@xml/locales_config"
		android:resizeableActivity="true"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.Type1"
		tools:targetApi="33">

		<activity
			android:name=".SettingsActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<activity
			android:name=".SetupActivity"
			android:exported="false"
			android:label="@string/setup_title" />

		<activity
			android:name=".ProfilesActivity"
			android:exported="false"
			android:label="@string/profiles_title" />

		<activity
			android:name=".BehaviourActivity"
			android:exported="false"
			android:label="@string/settings_behaviour" />

		<activity
			android:name=".AppearanceActivity"
			android:exported="false"
			android:label="@string/settings_appearance" />

		<activity
			android:name=".AboutActivity"
			android:exported="false"
			android:label="@string/settings_about" />

		<service
			android:name=".Type1Ime"
			android:exported="true"
			android:label="@string/ime_name"
			android:permission="android.permission.BIND_INPUT_METHOD">
			<intent-filter>
				<action android:name="android.view.InputMethod" />
			</intent-filter>
			<meta-data
				android:name="android.view.im"
				android:resource="@xml/method" />
		</service>
	</application>

</manifest>
