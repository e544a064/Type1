<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="24dp">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/profiles_title"
		android:textColor="#FF11131A"
		android:textSize="30sp"
		android:textStyle="bold" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="@string/profiles_subtitle"
		android:textColor="#FF4A5064"
		android:textSize="15sp" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_marginTop="16dp"
		android:layout_weight="1"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<TextView
				android:id="@+id/profileEmpty"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="24dp"
				android:paddingBottom="24dp"
				android:text="@string/profiles_empty"
				android:textColor="#FF6B7285"
				android:textSize="15sp" />

			<LinearLayout
				android:id="@+id/profileList"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />
		</LinearLayout>
	</ScrollView>

	<Button
		android:id="@+id/addProfileButton"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:layout_marginTop="12dp"
		android:contentDescription="@string/profiles_add_description"
		android:text="@string/profiles_add"
		android:textSize="24sp" />
</LinearLayout>
