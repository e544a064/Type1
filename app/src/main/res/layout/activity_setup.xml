<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="28dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/setup_title"
			android:textColor="#FF11131A"
			android:textSize="34sp"
			android:textStyle="bold" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/setup_subtitle"
			android:textColor="#FF4A5064"
			android:textSize="16sp" />

		<Button
			android:id="@+id/enableButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="36dp"
			android:text="@string/setup_step_enable" />

		<Button
			android:id="@+id/selectButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/setup_step_select" />

		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="36dp"
			android:lineSpacingExtra="4dp"
			android:text="@string/setup_hint"
			android:textColor="#FF6B7285"
			android:textSize="14sp" />

		<EditText
			android:id="@+id/demoField"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:background="#FFFFFFFF"
			android:gravity="top|start"
			android:hint="@string/setup_demo_hint"
			android:importantForAutofill="no"
			android:inputType="textCapSentences|textMultiLine"
			android:minLines="3"
			android:padding="12dp"
			android:textColor="#FF11131A"
			android:textColorHint="#FF8C93A8"
			android:textSize="16sp" />
	</LinearLayout>
</ScrollView>
